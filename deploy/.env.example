# Copy to /etc/sourcing-crm.env (or deploy/.env for Docker) and fill in. Never commit the real file.

# Port the app listens on behind the reverse proxy
PORT=3000
# SQLite database file; keep it on backed-up, encrypted storage
DB_FILE=/var/lib/sourcing-crm/crm.db
# Required when served over HTTPS (marks the sign-in cookie Secure)
COOKIE_SECURE=1

# First business head account, created only when the database has no users
ADMIN_NAME=Business Head
ADMIN_EMAIL=admin@yourbank.ae
ADMIN_PASSWORD=change-this-before-first-start

# Call recording requests: IT address, and an email relay that accepts POST {to, subject, text}
IT_EMAIL=
IT_EMAIL_WEBHOOK_URL=

# Optional Teams / Slack incoming webhooks
TL_WEBHOOK_URL=
PROCESSING_WEBHOOK_URL=

# Optional calling bot (leave blank to hide "Call with bot")
CALL_BOT_URL=
CALL_BOT_SECRET=
PUBLIC_URL=https://crm-test.yourbank.ae

# Optional: the verification bot's AI (Claude). Set the same key on the calling service for live calls.
# Check with compliance first: customer answers are sent to Anthropic.
ANTHROPIC_API_KEY=
# Optional: another model (a smaller one answers faster), and time limits in milliseconds
BOT_AI_MODEL=
BOT_AI_TIMEOUT_MS=
BOT_AI_PHRASE_TIMEOUT_MS=

# Native calling service (npm run bot:sip): your own SIP line, speech on this server, nothing leaves it.
# Set these on the server that runs the service; the CRM only needs CALL_BOT_URL and CALL_BOT_SECRET.
SIP_SERVER=
SIP_USERNAME=
SIP_PASSWORD=
SIP_DOMAIN=
SIP_CALLER_ID=
SIP_DISPLAY_NAME=Verification team
SIP_LOCAL_IP=
SIP_MEDIA_IP=
RTP_PORT_RANGE=10000-20000
STT_MODEL=/opt/speech/ggml-small.bin
TTS_MODEL=/opt/speech/en_GB-alba-medium.onnx
TTS_MODEL_AR=
BOT_RECORDINGS_DIR=/var/lib/sourcing-crm/recordings
BOT_RECORDING_DAYS=
BOT_MAX_CALLS=4
